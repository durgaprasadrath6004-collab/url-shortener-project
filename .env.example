# ==========================================
# Application Configuration (.env)
# ==========================================

# PostgreSQL Settings
POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring Boot Database connection
DATABASE_URL=jdbc:postgresql://postgres:5432/urlshortener
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (Base64-encoded 256-bit key)
JWT_SECRET=c29tZXN1cGVyc2VjcmV0a2V5Zm9ydXJsc2hvcnRlbmVycHJvamVjdDEyMzQ1Ng==

# Allowed CORS Origins (comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Frontend Environment Variables
VITE_BACKEND_URL=http://localhost:8080
VITE_REACT_FRONT_END_URL=http://localhost:3000
VITE_REACT_SUBDOMAIN=http://url.localhost:3000

